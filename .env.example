APP_NAME="Maison Anversa"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
ORDER_ADMIN_EMAIL=
BUREAU_MAIL_ADDRESS=

# Brevo (Heritage Letter + transactional SMTP)
BREVO_API_KEY=
BREVO_LIST_HERITAGE_LETTER=
BREVO_LIST_WAITLIST=
BREVO_LIST_ORDERS=2
BREVO_LIST_FOLDER_ID=
BREVO_WELCOME_VIA=brevo
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=

# DeepL (dynamic content). Free keys end with :fx and use api-free.deepl.com.
# Paid keys use api.deepl.com. Set DEEPL_API_HOST to override.
DEEPL_API_KEY=
DEEPL_API_HOST=

# GA4 measurement ID (gtag). Empty = no analytics script even with consent.
ANALYTICS_MEASUREMENT_ID=

# Bureau inbox for Contact / Club Corner inquiries
BUREAU_MAIL_ADDRESS=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# External Reverb server (separate repo/container: giuseppe_sav_maisonanversa_reverb_server).
# Do not install laravel/reverb here. REVERB_APP_* must match the Reverb server exactly.
# Local: REVERB_HOST=127.0.0.1 REVERB_PORT=8080 REVERB_SCHEME=http
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=ws.maisonanversa.com
REVERB_PORT=443
REVERB_SCHEME=https

# Vite build-time (Coolify Dockerfile build args). Expanded at npm run build.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Coolify monitoring / Servers&Maintenance (server-side only; never expose to Vite)
COOLIFY_API_URL=
COOLIFY_API_TOKEN=
COOLIFY_MAIN_APP_UUID=
COOLIFY_MAIN_APP_RESOURCE_TYPE=application
COOLIFY_REVERB_UUID=
COOLIFY_REVERB_RESOURCE_TYPE=application
MONITORING_MAIN_APP_URL="${APP_URL}"
MONITORING_MAIN_HEALTH_PATH=/up
MONITORING_REVERB_INTERNAL_HOST=
MONITORING_REVERB_INTERNAL_PORT=8080
# Keep true in production. false only when the WS host cert chain is untrusted (local/dev).
MONITORING_TLS_VERIFY=true
MONITORING_CHECK_INTERVAL_SECONDS=30
MONITORING_FAILURE_THRESHOLD=3
MONITORING_RESTART_COOLDOWN_SECONDS=120
MONITORING_AUTO_RECOVERY_ENABLED=false

# TEMPORARY: admin-type users get all Spatie permissions (see AdminTypePermissionBypass).
# Set false (or remove the Support class wires) when restoring Access Control.
MAISON_ADMIN_TYPE_GRANTS_ALL_PERMISSIONS=true

# Stripe / Laravel Cashier (EUR only)
# Local: stripe listen --forward-to http://127.0.0.1:8000/stripe/webhook
# Paste the printed whsec_… into STRIPE_WEBHOOK_SECRET, then: php artisan config:clear
# After a test payment, listen should show checkout.session.completed … [200]
# [403] means the signing secret does not match the current listen session
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
CASHIER_CURRENCY=eur
CASHIER_CURRENCY_LOCALE=nl_BE
ORDER_ADMIN_EMAIL=

# Sitemap cache TTL in seconds (0 = no cache, useful for local dev)
MAISON_SITEMAP_CACHE_SECONDS=3600

# Match-card PNG renderer (Satori + @resvg via Node). Production Docker keeps
# node + node_modules; override only if `node` is not on PATH.
MATCH_CARD_NODE=node